server {
    listen 80;
    listen [::]:80;
    server_name activity.20050619.xyz;

    client_max_body_size 24m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/blog-dynamic-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    listen 2053 ssl http2;
    listen [::]:2053 ssl http2;
    listen 2083 ssl http2;
    listen [::]:2083 ssl http2;
    listen 2087 ssl http2;
    listen [::]:2087 ssl http2;
    listen 2096 ssl http2;
    listen [::]:2096 ssl http2;
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;
    server_name activity.20050619.xyz;

    ssl_certificate /etc/letsencrypt/live/activity.20050619.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/activity.20050619.xyz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 24m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
