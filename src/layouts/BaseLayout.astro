---
import ThemeToggle from "@/components/ThemeToggle.astro";
import CursorCharacter from "@/components/CursorCharacter.astro";
import { siteConfig } from "@/config/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, siteConfig.url).toString();
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={siteConfig.icon} type="image/png" />
    <link rel="apple-touch-icon" href={siteConfig.icon} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const key = "blog-theme";
        const stored = localStorage.getItem(key);
        const theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>
          <img class="brand__mark" src={siteConfig.icon} alt="" width="36" height="36" />
          <span class="brand__text">{siteConfig.name}</span>
        </a>
        <nav class="nav" aria-label="主导航">
          <a href="/blog/">博客</a>
          <a href="/tags/">标签</a>
          <a href="/archive/">归档</a>
          <a href="/search/">搜索</a>
          <a href="/about/">关于</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© {new Date().getFullYear()} {siteConfig.author}</p>
        <nav class="feed-badges" aria-label="站点订阅和索引">
          <a class="feed-badge feed-badge--seo" href="/robots.txt">
            <span aria-hidden="true">◔</span>
            <span>SEO</span>
          </a>
          <a class="feed-badge feed-badge--sitemap" href="/sitemap-index.xml">Sitemap</a>
          <a class="feed-badge feed-badge--rss" href="/rss.xml">
            <span aria-hidden="true">◔</span>
            <span>订阅</span>
          </a>
          <a class="feed-badge feed-badge--plain" href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>
    <CursorCharacter />
    <slot name="body-end" />
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--glass), transparent 6%);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 18px;
    align-items: center;
    min-height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand__mark {
    width: 36px;
    height: 36px;
    border: 1px solid color-mix(in srgb, var(--surface), white 30%);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 8px 18px rgba(143, 75, 121, 0.2);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
  }

  .nav a {
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
  }

  .nav a:hover {
    background: var(--surface-muted);
  }

  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    padding: 28px 0;
  }

  .site-footer p {
    margin: 0;
  }

  .feed-badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }

  .feed-badge {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: 0 6px;
    border: 1px solid rgba(80, 65, 48, 0.24);
    border-radius: 2px;
    background: #dfd8c5;
    color: #5f563f;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.38),
      0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .feed-badge:hover {
    transform: translateY(-1px);
  }

  .feed-badge--sitemap {
    background: #839570;
    color: #fff7e4;
  }

  .feed-badge--rss {
    background: #ec873b;
    color: #fffaf0;
  }

  .feed-badge--plain {
    background: #f7f1df;
    color: #665c42;
  }

  .feed-badge span[aria-hidden="true"] {
    margin-right: 4px;
    font-size: 13px;
    transform: rotate(42deg);
  }

  @media (max-width: 760px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      padding: 12px 0;
    }

    .nav {
      grid-column: 1 / -1;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .brand__text {
      white-space: normal;
    }
  }
</style>
