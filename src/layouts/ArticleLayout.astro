---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CommentPlaceholder from "@/components/CommentPlaceholder.astro";
import { formatDate, type BlogPost } from "@/lib/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="narrow page-block">
    <header class="article-head">
      <div class="article-head__tags">
        {post.data.tags.map((tag) => <a class="pill" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-head__meta">
        <time datetime={post.data.pubDate.toISOString()}>发布于 {formatDate(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <time datetime={post.data.updatedDate.toISOString()}>
              更新于 {formatDate(post.data.updatedDate)}
            </time>
          )
        }
      </div>
    </header>
    <div class="article-content" data-pagefind-body>
      <slot />
    </div>
    <CommentPlaceholder />
  </article>
</BaseLayout>

<style>
  .article-head {
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .article-head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .article-head h1 {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.4rem);
    line-height: 1.18;
  }

  .article-head p {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .article-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
