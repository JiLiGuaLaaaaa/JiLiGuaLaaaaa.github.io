---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import { formatDate, getAllTags, getPublishedPosts, type BlogPost } from "@/lib/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const allPosts = await getPublishedPosts();
const allTags = getAllTags(allPosts);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <section class="article-banner">
    <div class="container article-banner__inner">
      <div class="article-head__tags">
        {post.data.tags.map((tag) => <a class="pill" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-head__meta">
        <time datetime={post.data.pubDate.toISOString()}>发布于 {formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <time datetime={post.data.updatedDate.toISOString()}>更新于 {formatDate(post.data.updatedDate)}</time>}
      </div>
    </div>
  </section>

  <section class="page-block">
    <div class="container layout-grid">
      <article class="article-shell vh-panel">
        <div class="article-content" data-pagefind-body>
          <slot />
        </div>
      </article>
      <div class="layout-sidebar">
        <ProfileCard postsCount={allPosts.length} tagsCount={allTags.length} hotTags={allTags} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-banner {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .article-banner::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 16% 24%, rgba(255, 198, 222, 0.72), transparent 34%),
      radial-gradient(circle at 84% 16%, rgba(194, 237, 255, 0.52), transparent 32%),
      linear-gradient(135deg, rgba(255, 244, 248, 0.98), rgba(255, 226, 239, 0.94) 52%, rgba(237, 249, 255, 0.9));
    content: "";
  }

  :global(:root[data-theme="dark"]) .article-banner::before {
    background:
      radial-gradient(circle at 16% 24%, rgba(126, 54, 88, 0.5), transparent 34%),
      radial-gradient(circle at 84% 16%, rgba(50, 83, 103, 0.42), transparent 32%),
      linear-gradient(135deg, rgba(32, 24, 32, 0.98), rgba(58, 35, 52, 0.95) 52%, rgba(28, 43, 58, 0.9));
  }

  .article-banner__inner {
    position: relative;
    display: grid;
    gap: 16px;
    min-height: 280px;
    align-content: end;
    padding: 62px 0 38px;
  }

  .article-shell {
    padding: clamp(22px, 4vw, 46px);
  }

  .article-head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .article-banner h1 {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.4rem);
    line-height: 1.18;
  }

  .article-banner p {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .article-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
