---
interface Props {
  limit?: number;
}

const { limit = 12 } = Astro.props;
const dynamicApiBase = (import.meta.env.PUBLIC_DYNAMIC_API_BASE || "").replace(/\/+$/, "");
---

<section
  class="dynamic-feed vh-panel"
  data-dynamic-feed
  data-api-base={dynamicApiBase}
  data-limit={limit}
  aria-labelledby="dynamic-feed-title"
>
  <div class="dynamic-feed__header">
    <div>
      <p class="dynamic-feed__eyebrow">Dynamic</p>
      <h2 id="dynamic-feed-title">动态</h2>
    </div>
    <button class="dynamic-compose-entry" type="button" aria-label="管理动态" data-dynamic-open>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 20h4.5L19.2 9.3a2.1 2.1 0 0 0 0-3L17.7 4.8a2.1 2.1 0 0 0-3 0L4 15.5V20Z" />
        <path d="M13.7 5.8l4.5 4.5" />
      </svg>
    </button>
  </div>

  <form class="dynamic-filter" data-dynamic-filter autocomplete="off">
    <label>
      <span>标题</span>
      <input type="search" placeholder="标题关键字" data-dynamic-filter-title />
    </label>
    <label>
      <span>正文</span>
      <input type="search" placeholder="正文关键字" data-dynamic-filter-content />
    </label>
    <label>
      <span>开始</span>
      <input type="date" data-dynamic-filter-from />
    </label>
    <label>
      <span>结束</span>
      <input type="date" data-dynamic-filter-to />
    </label>
    <div class="dynamic-filter__actions">
      <button type="submit">检索</button>
      <button type="reset">重置</button>
    </div>
  </form>

  <div class="dynamic-feed__status" data-dynamic-feed-status>正在读取公开动态。</div>
  <div class="dynamic-feed__list" data-dynamic-feed-list hidden></div>

  <div class="dynamic-password-modal" data-dynamic-password-modal hidden>
    <div class="dynamic-password-modal__backdrop"></div>
    <section
      class="dynamic-password-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dynamic-password-modal-title"
    >
      <button class="dynamic-password-modal__close" type="button" aria-label="关闭" data-dynamic-password-close>
        ×
      </button>
      <form class="dynamic-password-modal__form" data-dynamic-password-form autocomplete="off">
        <h3 id="dynamic-password-modal-title">动态管理</h3>
        <p class="dynamic-password-modal__hint">请输入发布密码后继续。</p>
        <label>
          <span>发布密码</span>
          <input type="password" autocomplete="off" data-dynamic-password />
        </label>
        <div class="dynamic-password-modal__actions">
          <button type="button" data-dynamic-password-cancel>取消</button>
          <button type="submit" data-dynamic-password-confirm>继续</button>
        </div>
      </form>
      <p class="dynamic-password-modal__status" data-dynamic-password-status></p>
    </section>
  </div>

  <div class="dynamic-manager-modal" data-dynamic-manager-modal hidden>
    <div class="dynamic-manager-modal__backdrop"></div>
    <section
      class="dynamic-manager-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dynamic-manager-title"
    >
      <button class="dynamic-manager-modal__close" type="button" aria-label="关闭" data-dynamic-manager-close>
        ×
      </button>
      <div class="dynamic-manager__top">
        <h3 id="dynamic-manager-title" data-dynamic-editor-heading>发布动态</h3>
        <div class="dynamic-manager__actions">
          <button type="button" data-dynamic-manage aria-pressed="false">管理</button>
          <button type="button" data-dynamic-new>新动态</button>
        </div>
      </div>
      <form class="dynamic-composer" data-dynamic-form autocomplete="off">
        <label>
          <span>标题</span>
          <input maxlength="80" placeholder="可不填" data-dynamic-title />
        </label>
        <label class="dynamic-composer__content">
          <span>正文</span>
          <textarea
            name="content"
            rows="5"
            maxlength="1000"
            placeholder="今天发生了什么？"
            data-dynamic-content
          ></textarea>
        </label>
        <div class="dynamic-existing-preview" data-dynamic-existing-preview hidden></div>
        <label class="dynamic-dropzone" data-dynamic-dropzone>
          <input type="file" accept="image/png,image/jpeg,image/webp" multiple data-dynamic-images />
          <span>拖入图片，或点击选择</span>
        </label>
        <div class="dynamic-image-preview" data-dynamic-image-preview hidden></div>
        <div class="dynamic-composer__bar">
          <button type="submit" data-dynamic-submit>发布</button>
        </div>
        <p class="dynamic-composer__status" data-dynamic-form-status></p>
      </form>
      <div class="dynamic-manager__list" data-dynamic-manager-list></div>
    </section>
  </div>
</section>

<script>
  type DynamicImage = {
    src?: string;
    alt?: string;
    type?: string;
    width?: number;
    height?: number;
  };

  type DynamicRecord = {
    id?: string;
    title?: string;
    content?: string;
    images?: DynamicImage[];
    createdAt?: string;
    updatedAt?: string;
  };

  type PendingImage = {
    file: File;
    dataUrl: string;
    previewUrl: string;
    width: number;
    height: number;
  };

  const shortTextLimit = 100;
  const maxImages = 4;
  const maxImageBytes = 3 * 1024 * 1024;

  const formatDate = (value: string) => {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }).format(date);
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => {
      const map: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      };
      return map[char] ?? char;
    });

  const resolveImageSrc = (apiBase: string, src: string) => {
    if (/^https?:\/\//i.test(src)) return src;
    return `${apiBase}${src.startsWith("/") ? src : `/${src}`}`;
  };

  const readImage = (file: File) =>
    new Promise<PendingImage>((resolve, reject) => {
      if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
        reject(new Error("只支持 JPG、PNG 和 WebP 图片。"));
        return;
      }
      if (file.size > maxImageBytes) {
        reject(new Error("单张图片不能超过 3 MB。"));
        return;
      }

      const reader = new FileReader();
      reader.addEventListener("error", () => reject(new Error("图片读取失败。")), { once: true });
      reader.addEventListener(
        "load",
        () => {
          const dataUrl = String(reader.result || "");
          const image = new Image();
          image.addEventListener(
            "load",
            () => {
              resolve({
                file,
                dataUrl,
                previewUrl: URL.createObjectURL(file),
                width: image.naturalWidth,
                height: image.naturalHeight
              });
            },
            { once: true }
          );
          image.addEventListener("error", () => reject(new Error("图片解析失败。")), { once: true });
          image.src = dataUrl;
        },
        { once: true }
      );
      reader.readAsDataURL(file);
    });

  const setupDynamicFeed = (root: HTMLElement) => {
    const apiBase = root.dataset.apiBase || "";
    const limit = Number.parseInt(root.dataset.limit || "12", 10) || 12;
    const status = root.querySelector<HTMLElement>("[data-dynamic-feed-status]")!;
    const list = root.querySelector<HTMLElement>("[data-dynamic-feed-list]")!;
    const filterForm = root.querySelector<HTMLFormElement>("[data-dynamic-filter]")!;
    const filterTitle = root.querySelector<HTMLInputElement>("[data-dynamic-filter-title]");
    const filterContent = root.querySelector<HTMLInputElement>("[data-dynamic-filter-content]");
    const filterFrom = root.querySelector<HTMLInputElement>("[data-dynamic-filter-from]");
    const filterTo = root.querySelector<HTMLInputElement>("[data-dynamic-filter-to]");
    const openButton = root.querySelector<HTMLButtonElement>("[data-dynamic-open]")!;
    const passwordModal = root.querySelector<HTMLElement>("[data-dynamic-password-modal]")!;
    const passwordForm = root.querySelector<HTMLFormElement>("[data-dynamic-password-form]")!;
    const passwordInput = root.querySelector<HTMLInputElement>("[data-dynamic-password]")!;
    const passwordStatus = root.querySelector<HTMLElement>("[data-dynamic-password-status]")!;
    const passwordSubmitButton = root.querySelector<HTMLButtonElement>("[data-dynamic-password-confirm]")!;
    const managerModal = root.querySelector<HTMLElement>("[data-dynamic-manager-modal]")!;
    const managerList = root.querySelector<HTMLElement>("[data-dynamic-manager-list]")!;
    const managerHeading = root.querySelector<HTMLElement>("[data-dynamic-editor-heading]")!;
    const manageButton = root.querySelector<HTMLButtonElement>("[data-dynamic-manage]")!;
    const newButton = root.querySelector<HTMLButtonElement>("[data-dynamic-new]")!;
    const form = root.querySelector<HTMLFormElement>("[data-dynamic-form]")!;
    const titleInput = root.querySelector<HTMLInputElement>("[data-dynamic-title]")!;
    const contentInput = root.querySelector<HTMLTextAreaElement>("[data-dynamic-content]")!;
    const formStatus = root.querySelector<HTMLElement>("[data-dynamic-form-status]")!;
    const submitButton = root.querySelector<HTMLButtonElement>("[data-dynamic-submit]")!;
    const fileInput = root.querySelector<HTMLInputElement>("[data-dynamic-images]")!;
    const dropzone = root.querySelector<HTMLElement>("[data-dynamic-dropzone]")!;
    const existingPreview = root.querySelector<HTMLElement>("[data-dynamic-existing-preview]")!;
    const preview = root.querySelector<HTMLElement>("[data-dynamic-image-preview]")!;

    if (
      !status ||
      !list ||
      !filterForm ||
      !openButton ||
      !passwordModal ||
      !passwordForm ||
      !passwordInput ||
      !passwordStatus ||
      !passwordSubmitButton ||
      !managerModal ||
      !managerList ||
      !managerHeading ||
      !manageButton ||
      !newButton ||
      !form ||
      !titleInput ||
      !contentInput ||
      !formStatus ||
      !submitButton ||
      !fileInput ||
      !dropzone ||
      !existingPreview ||
      !preview
    ) {
      return;
    }

    let records: DynamicRecord[] = [];
    let dynamicSessionToken = "";
    let pendingImages: PendingImage[] = [];
    let retainedImages: DynamicImage[] = [];
    let editingRecord: DynamicRecord | null = null;
    let dynamicManageMode = false;
    let filterTimer = 0;
    let requestToken = 0;

    const scrollEditorIntoView = () => {
      window.setTimeout(() => {
        form.scrollIntoView({ block: "start", behavior: "smooth" });
      }, 0);
    };

    const setModalOpen = (modal: HTMLElement, open: boolean) => {
      modal.hidden = !open;
      const hasOpenModal = !passwordModal.hidden || !managerModal.hidden || open;
      document.documentElement.classList.toggle("has-modal-open", hasOpenModal);
    };

    const closePasswordModal = () => {
      passwordStatus.textContent = "";
      passwordInput.value = "";
      setModalOpen(passwordModal, false);
    };

    const closeManagerModal = () => {
      resetEditor();
      setDynamicManageMode(false);
      setModalOpen(managerModal, false);
    };

    function setDynamicManageMode(active: boolean) {
      dynamicManageMode = active;
      manageButton.textContent = active ? "退出管理" : "管理";
      manageButton.setAttribute("aria-pressed", active ? "true" : "false");
      managerModal.classList.toggle("is-managing", active);
      renderManagerList();
    }

    const getFilterParams = () => {
      const params = new URLSearchParams({ limit: String(Math.max(limit, 24)) });
      const title = filterTitle?.value.trim() || "";
      const content = filterContent?.value.trim() || "";
      const from = filterFrom?.value || "";
      const to = filterTo?.value || "";
      if (title) params.set("title", title);
      if (content) params.set("content", content);
      if (from) params.set("from", from);
      if (to) params.set("to", to);
      return params;
    };

    const renderImageGrid = (images: DynamicImage[]) => {
      if (images.length === 0) return "";
      return `<div class="dynamic-item__images dynamic-item__images--${Math.min(images.length, maxImages)}">
        ${images
          .map((image) => {
            const src = escapeHtml(resolveImageSrc(apiBase, String(image.src || "")));
            const alt = escapeHtml(String(image.alt || "动态图片"));
            return `<a href="${src}" target="_blank" rel="noreferrer"><img src="${src}" alt="${alt}" loading="lazy" decoding="async" /></a>`;
          })
          .join("")}
      </div>`;
    };

    const renderRecords = () => {
      if (records.length === 0) {
        list.hidden = true;
        status.hidden = false;
        status.textContent = "暂时还没有符合条件的公开动态。";
        renderManagerList();
        return;
      }

      list.innerHTML = records
        .map((record) => {
          const title = String(record.title || "").trim();
          const content = String(record.content || "");
          const allImages = Array.isArray(record.images) ? record.images : [];
          const isLong = content.length > shortTextLimit || allImages.length > maxImages;
          const createdAt = formatDate(String(record.createdAt || ""));
          return `<article class="dynamic-item${isLong ? " is-collapsed" : ""}" data-dynamic-item>
            ${title ? `<h3>${escapeHtml(title)}</h3>` : ""}
            ${content ? `<p class="dynamic-item__content" data-dynamic-content-preview>${escapeHtml(content)}</p>` : ""}
            ${renderImageGrid(allImages)}
            <footer class="dynamic-item__footer">
              ${isLong ? `<button class="dynamic-item__toggle" type="button" data-dynamic-toggle>查看更多</button>` : "<span></span>"}
              ${createdAt ? `<time datetime="${escapeHtml(String(record.createdAt))}">${createdAt}</time>` : ""}
            </footer>
          </article>`;
        })
        .join("");
      status.hidden = true;
      list.hidden = false;
      renderManagerList();
    };

    const loadRecords = async (showStatus = true) => {
      if (!apiBase) {
        status.textContent = "动态暂未连接动态服务。";
        openButton.disabled = true;
        return;
      }

      const currentToken = ++requestToken;
      if (showStatus) {
        status.hidden = false;
        status.textContent = "正在读取公开动态。";
      }

      try {
        let response = await fetch(`${apiBase}/api/dynamics?${getFilterParams().toString()}`);
        if (response.status === 404) {
          response = await fetch(`${apiBase}/api/life?${getFilterParams().toString()}`);
        }
        if (!response.ok) throw new Error("Request failed");
        const payload = await response.json();
        if (currentToken !== requestToken) return;
        records = Array.isArray(payload?.records) ? payload.records : [];
        renderRecords();
      } catch {
        if (currentToken !== requestToken) return;
        list.hidden = true;
        status.hidden = false;
        status.textContent = "动态暂时不可用。";
      }
    };

    function resetEditor() {
      pendingImages.forEach((image) => URL.revokeObjectURL(image.previewUrl));
      pendingImages = [];
      retainedImages = [];
      editingRecord = null;
      titleInput.value = "";
      contentInput.value = "";
      managerHeading.textContent = "发布动态";
      submitButton.textContent = "发布";
      formStatus.textContent = "";
      renderExistingPreview();
      renderPendingPreview();
    }

    function renderExistingPreview() {
      if (retainedImages.length === 0) {
        existingPreview.hidden = true;
        existingPreview.innerHTML = "";
        return;
      }
      existingPreview.innerHTML = retainedImages
        .map((image, index) => {
          const src = escapeHtml(resolveImageSrc(apiBase, String(image.src || "")));
          return `<figure>
            <img src="${src}" alt="${escapeHtml(String(image.alt || "已有图片"))}" />
            <button type="button" data-remove-existing="${index}" aria-label="移除已有图片">×</button>
          </figure>`;
        })
        .join("");
      existingPreview.hidden = false;
    }

    function renderPendingPreview() {
      if (pendingImages.length === 0) {
        preview.hidden = true;
        preview.innerHTML = "";
        return;
      }
      preview.innerHTML = pendingImages
        .map(
          (image, index) => `<figure>
            <img src="${escapeHtml(image.previewUrl)}" alt="${escapeHtml(image.file.name)}" />
            <button type="button" data-remove-image="${index}" aria-label="移除图片">×</button>
          </figure>`
        )
        .join("");
      preview.hidden = false;
    }

    const addFiles = async (files: FileList | File[]) => {
      const remainingSlots = maxImages - retainedImages.length - pendingImages.length;
      const selectedFiles = Array.from(files).slice(0, Math.max(0, remainingSlots));
      if (selectedFiles.length === 0) {
        formStatus.textContent = "最多添加 4 张图片。";
        return;
      }
      try {
        const images = await Promise.all(selectedFiles.map(readImage));
        pendingImages = [...pendingImages, ...images].slice(0, Math.max(0, maxImages - retainedImages.length));
        formStatus.textContent = retainedImages.length + pendingImages.length >= maxImages ? "最多添加 4 张图片。" : "";
        renderPendingPreview();
      } catch (error) {
        formStatus.textContent = error instanceof Error ? error.message : "图片添加失败。";
      }
    };

    function startEdit(record: DynamicRecord) {
      pendingImages.forEach((image) => URL.revokeObjectURL(image.previewUrl));
      pendingImages = [];
      editingRecord = record;
      retainedImages = Array.isArray(record.images) ? [...record.images].slice(0, maxImages) : [];
      titleInput.value = String(record.title || "");
      contentInput.value = String(record.content || "");
      managerHeading.textContent = "编辑动态";
      submitButton.textContent = "保存";
      formStatus.textContent = "";
      renderExistingPreview();
      renderPendingPreview();
      scrollEditorIntoView();
      contentInput.focus();
    }

    function renderManagerList() {
      if (!managerList) return;
      if (!dynamicSessionToken) {
        managerList.innerHTML = "";
        return;
      }
      if (records.length === 0) {
        managerList.innerHTML = `<p class="dynamic-manager__empty">没有可管理的动态。</p>`;
        return;
      }
      managerList.innerHTML = records
        .map((record) => {
          const title = String(record.title || "").trim();
          const content = String(record.content || "").trim();
          const summary = title || content.slice(0, 52) || "无文字动态";
          const date = formatDate(String(record.createdAt || ""));
          return `<article class="dynamic-manager-item">
            <div>
              <strong>${escapeHtml(summary)}</strong>
              ${date ? `<time datetime="${escapeHtml(String(record.createdAt))}">${date}</time>` : ""}
            </div>
            ${
              dynamicManageMode
                ? `<div class="dynamic-manager-item__actions">
              <button type="button" data-dynamic-edit="${escapeHtml(String(record.id || ""))}">编辑</button>
              <button type="button" data-dynamic-delete="${escapeHtml(String(record.id || ""))}">删除</button>
            </div>`
                : ""
            }
          </article>`;
        })
        .join("");
    }

    if (!apiBase) {
      openButton.disabled = true;
    }

    openButton.addEventListener("click", () => {
      if (!apiBase) return;
      if (dynamicSessionToken) {
        setDynamicManageMode(false);
        setModalOpen(managerModal, true);
        renderManagerList();
        return;
      }
      setModalOpen(passwordModal, true);
      passwordStatus.textContent = "请输入发布密码。";
      window.setTimeout(() => passwordInput.focus(), 40);
    });

    passwordModal
      .querySelectorAll<HTMLElement>("[data-dynamic-password-close],[data-dynamic-password-cancel]")
      .forEach((closeTarget) => {
        closeTarget.addEventListener("click", closePasswordModal);
      });

    managerModal.querySelectorAll<HTMLElement>("[data-dynamic-manager-close]").forEach((closeTarget) => {
      closeTarget.addEventListener("click", closeManagerModal);
    });

    passwordForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const password = passwordInput.value;
      if (!password) {
        passwordStatus.textContent = "请输入发布密码。";
        passwordInput.focus();
        return;
      }

      passwordSubmitButton.disabled = true;
      passwordStatus.textContent = "正在确认。";
      try {
        const response = await fetch(`${apiBase}/api/dynamics/session`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password })
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload?.ok || !payload?.token) {
          throw new Error(payload?.error || "密码确认失败。");
        }
        dynamicSessionToken = String(payload.token);
        closePasswordModal();
        resetEditor();
        setDynamicManageMode(false);
        setModalOpen(managerModal, true);
        renderManagerList();
        scrollEditorIntoView();
      } catch (error) {
        passwordStatus.textContent = error instanceof Error ? error.message : "密码确认失败。";
      } finally {
        passwordSubmitButton.disabled = false;
      }
    });

    filterForm.addEventListener("submit", (event) => {
      event.preventDefault();
      window.clearTimeout(filterTimer);
      void loadRecords();
    });

    filterForm.addEventListener("reset", () => {
      window.setTimeout(() => {
        window.clearTimeout(filterTimer);
        void loadRecords();
      }, 0);
    });

    [filterTitle, filterContent, filterFrom, filterTo].forEach((input) => {
      input?.addEventListener("input", () => {
        window.clearTimeout(filterTimer);
        filterTimer = window.setTimeout(() => void loadRecords(false), 360);
      });
      input?.addEventListener("change", () => {
        window.clearTimeout(filterTimer);
        filterTimer = window.setTimeout(() => void loadRecords(false), 160);
      });
    });

    fileInput.addEventListener("change", () => {
      if (fileInput.files) void addFiles(fileInput.files);
      fileInput.value = "";
    });

    const handleDragOver = (event: DragEvent) => {
      event.preventDefault();
      dropzone.classList.add("is-dragging");
    };
    const handleDragLeave = (event: DragEvent) => {
      const nextTarget = event.relatedTarget;
      if (nextTarget instanceof Node && form.contains(nextTarget)) return;
      dropzone.classList.remove("is-dragging");
    };
    const handleDrop = (event: DragEvent) => {
      event.preventDefault();
      dropzone.classList.remove("is-dragging");
      if (event.dataTransfer?.files) void addFiles(event.dataTransfer.files);
    };

    form.addEventListener("dragover", handleDragOver);
    form.addEventListener("dragleave", handleDragLeave);
    form.addEventListener("drop", handleDrop);

    preview.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-image]");
      if (!button) return;
      const index = Number.parseInt(button.dataset.removeImage || "-1", 10);
      const [removed] = pendingImages.splice(index, 1);
      if (removed) URL.revokeObjectURL(removed.previewUrl);
      renderPendingPreview();
    });

    existingPreview.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-existing]");
      if (!button) return;
      const index = Number.parseInt(button.dataset.removeExisting || "-1", 10);
      retainedImages.splice(index, 1);
      renderExistingPreview();
    });

    manageButton.addEventListener("click", () => setDynamicManageMode(!dynamicManageMode));

    newButton.addEventListener("click", () => {
      resetEditor();
      scrollEditorIntoView();
      contentInput.focus();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const title = titleInput.value.trim();
      const content = contentInput.value.trim();
      if (!content && retainedImages.length + pendingImages.length === 0) {
        formStatus.textContent = "先写一点内容或添加图片。";
        contentInput.focus();
        return;
      }
      if (!dynamicSessionToken) {
        formStatus.textContent = "请重新确认发布密码。";
        setModalOpen(passwordModal, true);
        return;
      }

      submitButton.disabled = true;
      formStatus.textContent = editingRecord ? "正在保存。" : "正在发布。";
      try {
        const url = editingRecord?.id
          ? `${apiBase}/api/dynamics/${encodeURIComponent(editingRecord.id)}`
          : `${apiBase}/api/dynamics`;
        const response = await fetch(url, {
          method: editingRecord ? "PUT" : "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${dynamicSessionToken}`
          },
          body: JSON.stringify({
            title,
            content,
            existingImages: retainedImages,
            images: pendingImages.map((image) => ({
              dataUrl: image.dataUrl,
              name: image.file.name,
              type: image.file.type,
              width: image.width,
              height: image.height
            }))
          })
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload?.ok) {
          throw new Error(payload?.error || "动态保存失败。");
        }
        resetEditor();
        formStatus.textContent = "已保存。";
        await loadRecords(false);
      } catch (error) {
        if (error instanceof Error && /Unauthorized|expired/i.test(error.message)) {
          dynamicSessionToken = "";
        }
        formStatus.textContent = error instanceof Error ? error.message : "动态保存失败。";
      } finally {
        submitButton.disabled = false;
      }
    });

    managerList.addEventListener("click", async (event) => {
      const editButton = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-dynamic-edit]");
      const deleteButton = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-dynamic-delete]");
      if (editButton) {
        const record = records.find((item) => item.id === editButton.dataset.dynamicEdit);
        if (record) startEdit(record);
        return;
      }
      if (!deleteButton) return;
      const id = deleteButton.dataset.dynamicDelete || "";
      if (!id || !window.confirm("确定删除这条动态吗？")) return;
      deleteButton.disabled = true;
      formStatus.textContent = "正在删除。";
      try {
        const response = await fetch(`${apiBase}/api/dynamics/${encodeURIComponent(id)}`, {
          method: "DELETE",
          headers: { "Authorization": `Bearer ${dynamicSessionToken}` }
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload?.ok) {
          throw new Error(payload?.error || "删除失败。");
        }
        if (editingRecord?.id === id) resetEditor();
        await loadRecords(false);
        formStatus.textContent = "已删除。";
      } catch (error) {
        if (error instanceof Error && /Unauthorized|expired/i.test(error.message)) {
          dynamicSessionToken = "";
        }
        formStatus.textContent = error instanceof Error ? error.message : "删除失败。";
      } finally {
        deleteButton.disabled = false;
      }
    });

    list.addEventListener("click", (event) => {
      const toggle = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-dynamic-toggle]");
      if (!toggle) return;
      const item = toggle.closest<HTMLElement>("[data-dynamic-item]");
      if (!item) return;
      const collapsed = item.classList.toggle("is-collapsed");
      toggle.textContent = collapsed ? "查看更多" : "收起";
    });

    window.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (!managerModal.hidden) closeManagerModal();
      if (!passwordModal.hidden) closePasswordModal();
    });

    void loadRecords();
  };

  document.querySelectorAll<HTMLElement>("[data-dynamic-feed]").forEach(setupDynamicFeed);
</script>

