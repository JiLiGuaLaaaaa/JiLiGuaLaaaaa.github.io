<aside class="cursor-character" aria-label="站点小助手" data-cursor-character>
  <button class="cursor-character__hide" type="button" aria-label="隐藏小助手" data-character-hide>
    ×
  </button>
  <div class="cursor-character__bubble" data-character-bubble>今天也要写点什么吗？</div>
  <button class="cursor-character__stage" type="button" aria-label="和小助手打招呼" data-character-stage>
    <img
      class="cursor-character__frame is-visible"
      src="/images/video-mascot/look/center.png"
      alt=""
      loading="eager"
      decoding="async"
      width="860"
      height="680"
      data-character-frame
    />
    <img
      class="cursor-character__frame cursor-character__frame--buffer"
      src="/images/video-mascot/look/center.png"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      width="860"
      height="680"
      data-character-frame
    />
    <span class="cursor-character__missing" data-character-missing>小助手素材加载失败</span>
  </button>
</aside>

<button class="cursor-character-return" type="button" data-character-return aria-label="显示小助手">
  助手
</button>

<script>
  const character = document.querySelector<HTMLElement>("[data-cursor-character]");
  const stage = character?.querySelector<HTMLButtonElement>("[data-character-stage]");
  const bubble = character?.querySelector<HTMLElement>("[data-character-bubble]");
  const hideButton = character?.querySelector<HTMLButtonElement>("[data-character-hide]");
  const returnButton = document.querySelector<HTMLButtonElement>("[data-character-return]");
  const frameLayers = Array.from(character?.querySelectorAll<HTMLImageElement>("[data-character-frame]") ?? []);
  let activeFrame = frameLayers[0] ?? null;
  let standbyFrame = frameLayers[1] ?? null;
  const missing = character?.querySelector<HTMLElement>("[data-character-missing]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const positionKey = "blog-character-position";
  const hiddenKey = "blog-character-hidden";
  const frameBase = "/images/video-mascot";
  const lookFrames = {
    center: `${frameBase}/look/center.png`,
    up: `${frameBase}/look/up.png`,
    down: `${frameBase}/look/down.png`,
    left: `${frameBase}/look/left.png`,
    right: `${frameBase}/look/right.png`,
    "up-left": `${frameBase}/look/up-left.png`,
    "up-right": `${frameBase}/look/up-right.png`,
    "down-left": `${frameBase}/look/down-left.png`,
    "down-right": `${frameBase}/look/down-right.png`
  } as const;
  type LookFrameName = keyof typeof lookFrames;
  const angleFrameStep = 10;
  const angleFrameNames = Array.from({ length: 360 / angleFrameStep }, (_value, index) => index * angleFrameStep);
  const angleFrames = Object.fromEntries(
    angleFrameNames.map((angle) => [`a${String(angle).padStart(3, "0")}`, `${frameBase}/look-angle/a${String(angle).padStart(3, "0")}.png`])
  ) as Record<string, string>;
  const waveFrames = [
    `${frameBase}/wave/wave-0.png`,
    `${frameBase}/wave/wave-1.png`,
    `${frameBase}/wave/wave-2.png`,
    `${frameBase}/wave/wave-3.png`,
    `${frameBase}/wave/wave-4.png`,
    `${frameBase}/wave/wave-5.png`,
    `${frameBase}/wave/wave-6.png`,
    `${frameBase}/wave/wave-7.png`
  ];
  const blinkFrames = [
    `${frameBase}/blink/open.png`,
    `${frameBase}/blink/half-1.png`,
    `${frameBase}/blink/half-2.png`,
    `${frameBase}/blink/closed.png`,
    `${frameBase}/blink/open-2.png`
  ];
  const blinkSequence = [
    blinkFrames[1],
    blinkFrames[2],
    blinkFrames[3],
    blinkFrames[3],
    blinkFrames[2],
    blinkFrames[1],
    lookFrames.center
  ];
  const messages = [
    "今天也要写点什么吗？",
    "我在右下角陪你。",
    "欢迎你能来观看我的博客。",
    "你好呀，希望你每天都过的开心。",
    "记得要注意休息呀。",
    "Hello Hello!"
  ];
  const framePreloads = [...Object.values(lookFrames), ...Object.values(angleFrames), ...blinkFrames, ...waveFrames];
  const framePromises = new Map<string, Promise<boolean>>();
  type CharacterAction = "idle" | "blink" | "wave";
  let currentLook: keyof typeof lookFrames = "center";
  let displayedLook: keyof typeof lookFrames = "center";
  let currentAngleFrame = "center";
  let currentAction: CharacterAction = "idle";
  let messageIndex = 0;
  let animationToken = 0;
  let lookToken = 0;
  let frameSwapToken = 0;
  let currentFrameSrc = activeFrame?.getAttribute("src") ?? "";
  let hasVisibleFrame = Boolean(activeFrame);
  let lastPointerAt = performance.now();
  let lastLookChangedAt = performance.now();
  let dragStart: { x: number; y: number; right: number; bottom: number } | null = null;
  let didDrag = false;

  const wait = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

  const preloadFrame = (src: string) => {
    const cached = framePromises.get(src);
    if (cached) return cached;

    const image = new Image();
    image.decoding = "async";
    const promise = new Promise<boolean>((resolve) => {
      let settled = false;
      const finish = (loaded: boolean) => {
        if (settled) return;
        settled = true;
        resolve(loaded);
      };
      image.addEventListener(
        "load",
        () => {
          if (typeof image.decode === "function") {
            void image.decode().then(
              () => finish(true),
              () => finish(true)
            );
            return;
          }
          finish(true);
        },
        { once: true }
      );
      image.addEventListener("error", () => finish(false), { once: true });
    });

    image.src = src;
    framePromises.set(src, promise);
    return promise;
  };

  const warmFrames = (frames: string[]) => Promise.allSettled(frames.map((src) => preloadFrame(src)));

  const setFrame = async (src: string) => {
    if (!activeFrame) return false;
    if (currentFrameSrc === src && activeFrame.classList.contains("is-visible")) return true;

    const token = ++frameSwapToken;
    const loaded = await preloadFrame(src);
    if (token !== frameSwapToken) return false;

    if (!loaded) {
      if (!hasVisibleFrame) {
        missing?.classList.add("is-visible");
      }
      return false;
    }

    const nextFrame = standbyFrame ?? activeFrame;
    if (nextFrame.getAttribute("src") !== src) {
      nextFrame.src = src;
    }

    if (typeof nextFrame.decode === "function") {
      await nextFrame.decode().catch(() => undefined);
    }
    if (token !== frameSwapToken) return false;

    if (nextFrame !== activeFrame) {
      nextFrame.dataset.currentSrc = src;
      nextFrame.classList.add("is-visible");
      activeFrame.classList.remove("is-visible");
      const previousFrame = activeFrame;
      activeFrame = nextFrame;
      standbyFrame = previousFrame;
    } else {
      nextFrame.dataset.currentSrc = src;
      nextFrame.classList.add("is-visible");
    }

    currentFrameSrc = src;
    hasVisibleFrame = true;
    missing?.classList.remove("is-visible");
    return true;
  };

  const say = (text?: string) => {
    if (!bubble) return;
    messageIndex = text ? messageIndex : (messageIndex + 1) % messages.length;
    bubble.textContent = text ?? messages[messageIndex];
    bubble.classList.remove("is-popping");
    window.requestAnimationFrame(() => bubble.classList.add("is-popping"));
  };

  const setHidden = (hidden: boolean) => {
    if (!character || !returnButton) return;
    character.classList.toggle("is-hidden", hidden);
    returnButton.classList.toggle("is-visible", hidden);
    localStorage.setItem(hiddenKey, hidden ? "1" : "0");
  };

  const applyStoredPosition = () => {
    if (!character) return;
    const stored = localStorage.getItem(positionKey);
    if (!stored) return;
    const position = JSON.parse(stored) as { right: number; bottom: number };
    character.style.right = `${Math.max(12, position.right)}px`;
    character.style.bottom = `${Math.max(12, position.bottom)}px`;
  };

  const pickLookFrame = (dx: number, dy: number): keyof typeof lookFrames => {
    const absX = Math.abs(dx);
    const absY = Math.abs(dy);
    const straightVertical = absY >= 0.34 && absX < 0.22;
    const horizontal = straightVertical || absX < 0.26 ? "" : dx < 0 ? "left" : "right";
    const vertical = absY < 0.30 || (!straightVertical && absY < absX * 0.68) ? "" : dy < 0 ? "up" : "down";

    if (vertical && horizontal) return `${vertical}-${horizontal}` as keyof typeof lookFrames;
    if (vertical) return vertical as keyof typeof lookFrames;
    if (horizontal) return horizontal as keyof typeof lookFrames;
    return "center";
  };

  const setLook = (look: LookFrameName, forceFrame = false) => {
    if (!forceFrame && look === currentLook) return;
    currentLook = look;
    lastLookChangedAt = performance.now();
    lookToken += 1;
    displayedLook = look;
    currentAngleFrame = look;
    if (currentAction === "idle" || forceFrame) void setFrame(lookFrames[currentLook]);
  };

  const setAngleLook = async (angleKey: string) => {
    if (!activeFrame || reduceMotion.matches || currentAction !== "idle" || currentAngleFrame === angleKey) return;
    const src = angleFrames[angleKey];
    if (!src) return;
    const token = ++lookToken;
    currentAngleFrame = angleKey;
    displayedLook = "center";
    lastLookChangedAt = performance.now();
    await preloadFrame(src);
    if (token === lookToken && currentAction === "idle") await setFrame(src);
  };

  const playFrames = async (
    frames: string[],
    action: CharacterAction,
    delay = 95,
    returnLook: LookFrameName = currentLook
  ) => {
    if (!activeFrame || reduceMotion.matches) return;
    const token = ++animationToken;
    lookToken += 1;
    currentAction = action;
    character?.classList.remove("is-animating");
    await warmFrames(frames);
    if (token !== animationToken) return;
    character?.classList.toggle("is-animating", action === "wave");
    for (const src of frames) {
      if (token !== animationToken) return;
      await setFrame(src);
      await wait(delay);
    }
    if (token === animationToken) {
      currentAction = "idle";
      setLook(returnLook, true);
      character?.classList.remove("is-animating");
    }
  };

  const playBlink = () => {
    if (character?.classList.contains("is-hidden")) return;
    if (document.hidden || currentAction !== "idle" || currentLook !== "center" || displayedLook !== "center") return;
    if (currentAngleFrame !== "center" || performance.now() - lastLookChangedAt < 1100) return;
    if (performance.now() - lastPointerAt < 2200) return;
    void playFrames(blinkSequence, "blink", 155, "center");
  };

  const playWave = () => {
    say();
    setLook("center", true);
    void playFrames([...waveFrames, lookFrames.center], "wave", 92, "center");
  };

  frameLayers.forEach((layer) => {
    layer.dataset.currentSrc = layer.getAttribute("src") ?? "";
    layer.addEventListener("load", () => {
      if (!layer.classList.contains("is-visible")) return;
      hasVisibleFrame = true;
      missing?.classList.remove("is-visible");
    });
    layer.addEventListener("error", () => {
      if (hasVisibleFrame) return;
      missing?.classList.add("is-visible");
    });
  });

  stage?.addEventListener("click", () => {
    if (didDrag) return;
    playWave();
  });
  hideButton?.addEventListener("click", () => setHidden(true));
  returnButton?.addEventListener("click", () => {
    setHidden(false);
    say("我回来啦。");
    setLook("center", true);
    void playFrames([...waveFrames, lookFrames.center], "wave", 92, "center");
  });

  stage?.addEventListener("pointerdown", (event) => {
    if (!character || event.button !== 0) return;
    const styles = window.getComputedStyle(character);
    didDrag = false;
    dragStart = {
      x: event.clientX,
      y: event.clientY,
      right: parseFloat(styles.right),
      bottom: parseFloat(styles.bottom)
    };
    stage.setPointerCapture(event.pointerId);
  });

  stage?.addEventListener("pointermove", (event) => {
    if (!character || !dragStart) return;
    const nextRight = dragStart.right - (event.clientX - dragStart.x);
    const nextBottom = dragStart.bottom - (event.clientY - dragStart.y);
    didDrag = didDrag || Math.abs(event.clientX - dragStart.x) > 4 || Math.abs(event.clientY - dragStart.y) > 4;
    character.style.right = `${Math.max(12, Math.min(window.innerWidth - 112, nextRight))}px`;
    character.style.bottom = `${Math.max(12, Math.min(window.innerHeight - 160, nextBottom))}px`;
  });

  stage?.addEventListener("pointerup", () => {
    if (!character || !dragStart) return;
    const styles = window.getComputedStyle(character);
    localStorage.setItem(
      positionKey,
      JSON.stringify({
        right: parseFloat(styles.right),
        bottom: parseFloat(styles.bottom)
      })
    );
    dragStart = null;
  });

  const pickAngleFrame = (dx: number, dy: number) => {
    const distance = Math.hypot(dx, dy);
    if (distance < 0.20) return "center";
    const angle = (Math.atan2(dy, dx) * 180) / Math.PI;
    const normalized = (Math.round(((angle + 360) % 360) / angleFrameStep) * angleFrameStep) % 360;
    return `a${String(normalized).padStart(3, "0")}`;
  };

  if (character && activeFrame && !reduceMotion.matches) {
    window.addEventListener(
      "pointermove",
      (event) => {
        lastPointerAt = performance.now();
        if (dragStart || currentAction !== "idle") return;
        const rect = character.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const dx = Math.max(-1, Math.min(1, (event.clientX - centerX) / 430));
        const dy = Math.max(-1, Math.min(1, (event.clientY - centerY) / 300));
        const nextLook = pickLookFrame(dx, dy);
        const angleLook = pickAngleFrame(dx, dy);

        if (angleLook === "center") {
          setLook(nextLook);
        } else {
          currentLook = nextLook;
          void setAngleLook(angleLook);
        }
      },
      { passive: true }
    );
  }

  applyStoredPosition();
  setHidden(localStorage.getItem(hiddenKey) === "1");
  void warmFrames(framePreloads).then(() => character?.classList.add("are-frames-ready"));
  window.setInterval(playBlink, 5200);
  window.setInterval(() => {
    if (!document.hidden && !character?.classList.contains("is-hidden")) {
      say(messages[messageIndex]);
    }
  }, 16000);
</script>

<style>
  .cursor-character {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 15;
    width: min(226px, 26vw);
    min-width: 164px;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .cursor-character.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(16px) scale(0.92);
  }

  .cursor-character__hide {
    position: absolute;
    top: 30px;
    right: 2px;
    z-index: 2;
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    line-height: 1;
  }

  .cursor-character__bubble {
    position: relative;
    width: max-content;
    max-width: 190px;
    margin: 0 auto -4px;
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface), white 12%);
    color: var(--text);
    font-size: 0.78rem;
    line-height: 1.35;
    box-shadow: var(--shadow);
    transform-origin: bottom center;
  }

  .cursor-character__bubble::after {
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 10px;
    height: 10px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: inherit;
    content: "";
    transform: translateX(-50%) rotate(45deg);
  }

  .cursor-character__bubble.is-popping {
    animation: bubble-pop 360ms ease;
  }

  .cursor-character__stage {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 860 / 500;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: transparent;
    filter: drop-shadow(0 18px 20px rgba(122, 54, 83, 0.22));
    touch-action: none;
    transition: transform 160ms ease-out;
  }

  .cursor-character__stage:hover {
    transform: translateY(-2px);
  }

  .cursor-character__frame {
    display: block;
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 860 / 680;
    max-height: 248px;
    object-fit: contain;
    object-position: center bottom;
    animation: floaty 4.8s ease-in-out infinite;
    opacity: 0;
    pointer-events: none;
    transform: translateZ(0);
    transition: opacity 1ms linear;
  }

  .cursor-character__frame.is-visible {
    opacity: 1;
  }

  .cursor-character.is-animating .cursor-character__frame {
    animation: floaty 4.8s ease-in-out infinite;
  }

  .cursor-character__missing {
    display: none;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.78rem;
  }

  .cursor-character__missing.is-visible {
    display: inline-block;
  }

  .cursor-character-return {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 15;
    display: none;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .cursor-character-return.is-visible {
    display: inline-flex;
    align-items: center;
  }

  @keyframes floaty {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -7px;
    }
  }

  @keyframes bubble-pop {
    0% {
      transform: scale(0.96);
    }
    60% {
      transform: scale(1.04);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (max-width: 760px), (prefers-reduced-motion: reduce) {
    .cursor-character,
    .cursor-character-return {
      display: none;
    }

    .cursor-character__frame {
      animation: none;
    }
  }
</style>
