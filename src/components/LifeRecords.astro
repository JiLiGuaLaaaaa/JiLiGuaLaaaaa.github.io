---
interface Props {
  limit?: number;
}

const { limit = 12 } = Astro.props;
const dynamicApiBase = (import.meta.env.PUBLIC_DYNAMIC_API_BASE || "").replace(/\/+$/, "");
---

<section
  class="life-records vh-panel"
  data-life-records
  data-api-base={dynamicApiBase}
  data-limit={limit}
  aria-labelledby="life-records-title"
>
  <div class="life-records__header">
    <p class="life-records__eyebrow">Life</p>
    <h2 id="life-records-title">生活记录</h2>
  </div>
  <div class="life-records__status" data-life-records-status>正在读取公开记录。</div>
  <div class="life-records__list" data-life-records-list hidden></div>
</section>

<script>
  type LifeRecord = {
    id?: string;
    title?: string;
    content?: string;
    mood?: string;
    createdAt?: string;
  };

  const formatDate = (value: string) => {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }).format(date);
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => {
      const map: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      };
      return map[char] ?? char;
    });

  const renderLifeRecords = async (root: HTMLElement) => {
    const apiBase = root.dataset.apiBase;
    const limit = Number.parseInt(root.dataset.limit || "12", 10) || 12;
    const status = root.querySelector<HTMLElement>("[data-life-records-status]");
    const list = root.querySelector<HTMLElement>("[data-life-records-list]");
    if (!status || !list) return;

    if (!apiBase) {
      status.textContent = "生活记录暂未连接动态服务。";
      return;
    }

    try {
      const response = await fetch(`${apiBase}/api/life?limit=${encodeURIComponent(String(limit))}`);
      if (!response.ok) throw new Error("Request failed");
      const payload = await response.json();
      const records: LifeRecord[] = Array.isArray(payload?.records) ? payload.records : [];
      if (records.length === 0) {
        status.textContent = "暂时还没有公开生活记录。";
        return;
      }

      list.innerHTML = records
        .map((record) => {
          const title = escapeHtml(String(record.title || "生活记录"));
          const content = escapeHtml(String(record.content || ""));
          const mood = escapeHtml(String(record.mood || ""));
          const createdAt = formatDate(String(record.createdAt || ""));
          return `<article class="life-record">
            <div class="life-record__meta">
              ${createdAt ? `<time datetime="${escapeHtml(String(record.createdAt))}">${createdAt}</time>` : ""}
              ${mood ? `<span>${mood}</span>` : ""}
            </div>
            <h3>${title}</h3>
            <p>${content}</p>
          </article>`;
        })
        .join("");
      status.hidden = true;
      list.hidden = false;
    } catch {
      status.textContent = "生活记录暂时不可用。";
    }
  };

  document.querySelectorAll<HTMLElement>("[data-life-records]").forEach((root) => {
    void renderLifeRecords(root);
  });
</script>

<style>
  .life-records {
    display: grid;
    gap: 18px;
    padding: 22px;
  }

  .life-records__header {
    display: grid;
    gap: 4px;
  }

  .life-records__eyebrow {
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .life-records h2 {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.25;
  }

  .life-records__status {
    color: var(--muted);
  }

  .life-records__list {
    display: grid;
    gap: 14px;
  }

  .life-record {
    display: grid;
    gap: 8px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface-muted), transparent 12%);
  }

  .life-record__meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .life-record h3 {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .life-record p {
    margin: 0;
    color: var(--text);
    white-space: pre-wrap;
  }
</style>
