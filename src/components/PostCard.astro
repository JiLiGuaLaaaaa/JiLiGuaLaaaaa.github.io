---
import type { BlogPost } from "@/lib/posts";
import { formatDate, getPostSlug } from "@/lib/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const slug = getPostSlug(post);
---

<article class="post-card card">
  <a class="post-card__title" href={`/blog/${slug}/`}>
    <h2>{post.data.title}</h2>
  </a>
  <p class="post-card__description">{post.data.description}</p>
  <footer class="post-card__meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <div class="post-card__tags" aria-label="文章标签">
      {post.data.tags.map((tag) => <a class="pill" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
    </div>
  </footer>
</article>

<style>
  .post-card {
    position: relative;
    padding: 22px;
    overflow: hidden;
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .post-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--link), white 18%));
    content: "";
    opacity: 0.76;
  }

  .post-card:hover {
    border-color: color-mix(in srgb, var(--accent), var(--border) 40%);
    box-shadow: 0 22px 54px rgba(128, 70, 105, 0.18);
    transform: translateY(-2px);
  }

  .post-card__title {
    color: var(--text);
    text-decoration: none;
  }

  .post-card__title h2 {
    margin: 0;
    font-size: 1.28rem;
    line-height: 1.35;
  }

  .post-card__description {
    margin: 12px 0 18px;
    color: var(--muted);
    font-size: 0.96rem;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
