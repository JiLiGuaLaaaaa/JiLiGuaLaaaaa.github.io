---
import { siteConfig } from "@/config/site";

interface Props {
  postsCount?: number;
  tagsCount?: number;
  hotTags?: Array<{
    name: string;
    count: number;
  }>;
}

const { postsCount = 0, tagsCount = 0, hotTags = [] } = Astro.props;
const visibleHotTags = [...hotTags]
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"))
  .slice(0, 12);
---

<aside class="profile-card card" aria-label="博客资料卡">
  <img class="profile-card__avatar" src={siteConfig.avatar} alt={`${siteConfig.author} 的头像`} width="112" height="112" />
  <div class="profile-card__body">
    <h2>{siteConfig.author}</h2>
    <p>{siteConfig.description}</p>
  </div>
  <dl class="profile-card__stats">
    <div>
      <dt>文章</dt>
      <dd>{postsCount}</dd>
    </div>
    <div>
      <dt>标签</dt>
      <dd>{tagsCount}</dd>
    </div>
  </dl>
  {visibleHotTags.length > 0 && (
    <section class="profile-card__hot-tags" aria-labelledby="profile-hot-tags-title">
      <h3 id="profile-hot-tags-title">热门标签</h3>
      <div class="profile-card__tag-list">
        {visibleHotTags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag.name)}/`}>
            <span>{tag.name}</span>
            <sup>{tag.count}</sup>
          </a>
        ))}
      </div>
    </section>
  )}
  <div class="profile-card__social" aria-label="公开社交信息">
    <span>QQ</span>
    <strong>{siteConfig.social.qq}</strong>
  </div>
</aside>

<style>
  .profile-card {
    display: grid;
    gap: 16px;
    justify-items: center;
    padding: 24px 20px;
    text-align: center;
  }

  .profile-card__avatar {
    width: 112px;
    height: 112px;
    border: 4px solid color-mix(in srgb, var(--surface), white 40%);
    border-radius: 50%;
    box-shadow: 0 14px 30px rgba(143, 75, 121, 0.24);
    object-fit: cover;
  }

  .profile-card__body h2 {
    margin: 0;
    font-size: 1.28rem;
    line-height: 1.25;
  }

  .profile-card__body p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .profile-card__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface-muted), transparent 10%);
  }

  .profile-card__stats div {
    padding: 12px;
  }

  .profile-card__stats div + div {
    border-left: 1px solid var(--border);
  }

  .profile-card__stats dt {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .profile-card__stats dd {
    margin: 2px 0 0;
    color: var(--accent-strong);
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1;
  }

  .profile-card__hot-tags {
    display: grid;
    width: 100%;
    gap: 10px;
    text-align: left;
  }

  .profile-card__hot-tags h3 {
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .profile-card__tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 12px;
  }

  .profile-card__tag-list a {
    display: inline-flex;
    gap: 3px;
    align-items: flex-start;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .profile-card__tag-list a:hover {
    color: var(--accent-strong);
  }

  .profile-card__tag-list sup {
    color: var(--accent-strong);
    font-size: 0.64rem;
    line-height: 1;
  }

  .profile-card__social {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface-muted), transparent 8%);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .profile-card__social strong {
    color: var(--text);
    font-weight: 800;
  }
</style>
