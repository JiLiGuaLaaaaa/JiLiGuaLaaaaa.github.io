---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllTags, getPublishedPosts } from "@/lib/posts";

const tags = getAllTags(await getPublishedPosts());
---

<BaseLayout title="标签" description="按标签浏览公开文章。">
  <section class="narrow page-block">
    <h1 class="section-title">标签</h1>
    <p class="muted">按主题整理文章。</p>
    <div class="tag-list">
      {tags.map((tag) => <a class="pill" href={`/tags/${encodeURIComponent(tag.name)}/`}>{tag.name} · {tag.count}</a>)}
    </div>
  </section>
</BaseLayout>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
</style>
