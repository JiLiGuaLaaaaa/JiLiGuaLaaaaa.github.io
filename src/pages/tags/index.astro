---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllTags, getPublishedPosts } from "@/lib/posts";

const tags = getAllTags(await getPublishedPosts());
---

<BaseLayout title="标签" description="按标签浏览公开文章。">
  <section class="page-hero" data-collapsible-banner>
    <div class="page-hero__media" aria-hidden="true">
      <img src="/images/banner/tags.png" alt="" loading="eager" decoding="async" />
      <img src="/images/banner/tags.png" alt="" loading="eager" decoding="async" />
    </div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">Tags</p>
      <h1>标签</h1>
      <p>按主题整理文章。</p>
    </div>
  </section>
  <section class="narrow page-block">
    <div class="tag-panel vh-panel">
      <div class="tag-list">
        {tags.map((tag) => <a class="pill" href={`/tags/${encodeURIComponent(tag.name)}/`}>{tag.name} · {tag.count}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag-panel {
    padding: 26px;
  }
</style>
