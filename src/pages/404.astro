---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="这个页面不存在。">
  <section class="narrow page-block not-found">
    <p class="not-found__code">404</p>
    <h1 class="section-title">页面不存在</h1>
    <p class="muted">可能是地址写错了，或者这个页面还没有创建。</p>
    <a class="home-link" href="/">返回首页</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 52vh;
  }

  .not-found__code {
    margin: 0;
    color: var(--accent);
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    margin-top: 20px;
    padding: 0 16px;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-weight: 800;
    text-decoration: none;
  }
</style>
