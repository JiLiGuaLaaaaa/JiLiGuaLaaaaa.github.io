---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import { siteConfig } from "@/config/site";
import { getAllTags, getPostSlug, getPublishedPosts } from "@/lib/posts";

const posts = await getPublishedPosts();
const featuredPosts = posts.slice(0, 5);
const allTags = getAllTags(posts);
const tags = allTags.slice(0, 14);
const latestPost = featuredPosts[0];
const latestPostSlug = latestPost ? getPostSlug(latestPost) : "";
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="home-banner">
    <div class="container home-banner__inner">
      <div class="home-banner__copy">
        <p class="home-banner__eyebrow">Welcome Back</p>
        <h1>{siteConfig.name}</h1>
        <p>{siteConfig.description}</p>
      </div>
      <div class="home-banner__actions">
        <a class="button button--primary" href="/blog/">进入博客</a>
        <a class="button button--ghost" href="/archive/">查看归档</a>
      </div>
    </div>
  </section>

  <section class="page-block">
    <div class="container home-grid">
      <div class="home-main">
        <section class="notice-card vh-panel" aria-labelledby="notice-title">
          <div>
            <p class="panel-eyebrow">Notice</p>
            <h2 id="notice-title">公开博客保持静态</h2>
            <p>动态、留言、朋友圈等功能以后会单独放到服务器服务中；当前站点只保留快速、轻量、方便迁移的公开内容。</p>
          </div>
          <a class="text-link" href="/about/">了解更多</a>
        </section>

        {latestPost && (
          <section class="featured-card vh-panel" aria-labelledby="featured-title">
            <div>
              <p class="panel-eyebrow">Latest</p>
              <h2 id="featured-title">{latestPost.data.title}</h2>
              <p>{latestPost.data.description}</p>
            </div>
            <a class="button button--primary" href={`/blog/${latestPostSlug}/`}>阅读最新文章</a>
          </section>
        )}

        <div class="split-heading">
          <div>
            <p class="panel-eyebrow">Articles</p>
            <h2 class="section-title">最近更新</h2>
          </div>
          <a class="text-link" href="/blog/">全部文章</a>
        </div>
        <div class="post-grid">
          {featuredPosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>

      <aside class="home-side" aria-label="侧边信息">
        <ProfileCard postsCount={posts.length} tagsCount={allTags.length} hotTags={allTags} />
        <section class="tag-panel vh-panel" aria-labelledby="home-tags-title">
          <p class="panel-eyebrow">Tags</p>
          <h2 id="home-tags-title">标签</h2>
          <div class="tag-list">
            {tags.map((tag) => <a class="pill" href={`/tags/${encodeURIComponent(tag.name)}/`}>{tag.name} · {tag.count}</a>)}
          </div>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .home-banner {
    position: relative;
    min-height: 410px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .home-banner::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 26%, rgba(255, 191, 221, 0.82), transparent 34%),
      radial-gradient(circle at 82% 20%, rgba(191, 235, 255, 0.58), transparent 33%),
      linear-gradient(135deg, rgba(255, 244, 248, 0.98), rgba(255, 226, 239, 0.94) 52%, rgba(236, 249, 255, 0.9));
    content: "";
  }

  .home-banner::after {
    position: absolute;
    inset: auto 0 0;
    height: 120px;
    background: linear-gradient(180deg, transparent, var(--bg));
    content: "";
  }

  :global(:root[data-theme="dark"]) .home-banner::before {
    background:
      radial-gradient(circle at 18% 26%, rgba(126, 54, 88, 0.58), transparent 34%),
      radial-gradient(circle at 82% 20%, rgba(50, 83, 103, 0.46), transparent 33%),
      linear-gradient(135deg, rgba(32, 24, 32, 0.98), rgba(58, 35, 52, 0.95) 52%, rgba(28, 43, 58, 0.9));
  }

  .home-banner__inner {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 410px;
    align-content: end;
    gap: 24px;
    padding: 78px 0 70px;
  }

  .home-banner__eyebrow,
  .panel-eyebrow {
    margin: 0 0 10px;
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-banner h1 {
    margin: 0;
    max-width: 760px;
    font-size: clamp(2.6rem, 1.55rem + 4vw, 5.4rem);
    line-height: 1.04;
  }

  .home-banner__copy > p:not(.home-banner__eyebrow) {
    max-width: 620px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 1.12rem;
  }

  .home-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 22px;
    align-items: start;
    margin-top: -92px;
  }

  .home-main,
  .home-side {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 18px;
  }

  .home-side {
    position: sticky;
    top: calc(var(--header-height) + 20px);
  }

  .notice-card,
  .featured-card,
  .tag-panel {
    padding: 22px;
  }

  .notice-card,
  .featured-card {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }

  .notice-card h2,
  .featured-card h2,
  .tag-panel h2 {
    margin: 0;
    font-size: 1.28rem;
    line-height: 1.3;
  }

  .notice-card p:not(.panel-eyebrow),
  .featured-card p:not(.panel-eyebrow) {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .split-heading {
    display: flex;
    gap: 18px;
    align-items: end;
    justify-content: space-between;
    padding: 4px 2px 0;
  }

  .split-heading .section-title {
    margin: 0;
  }

  .text-link {
    font-weight: 800;
    white-space: nowrap;
  }

  .post-grid {
    display: grid;
    gap: 18px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .button--primary {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .button--ghost {
    background: var(--surface);
    color: var(--text);
  }

  @media (max-width: 920px) {
    .home-grid {
      grid-template-columns: 1fr;
      margin-top: -58px;
    }

    .home-side {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 680px) {
    .home-banner,
    .home-banner__inner {
      min-height: 350px;
    }

    .notice-card,
    .featured-card {
      display: grid;
      align-items: start;
    }
  }
</style>
