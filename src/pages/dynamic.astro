---
import DynamicFeed from "@/components/DynamicFeed.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="动态" description="辣子鸡丁砂锅公开分享的动态。">
  <section class="page-hero" data-collapsible-banner>
    <div class="page-hero__media" aria-hidden="true">
      <img src="/images/banner/dynamic.jpg" alt="" loading="eager" decoding="async" />
      <img src="/images/banner/dynamic.jpg" alt="" loading="eager" decoding="async" />
    </div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">Dynamic</p>
      <h1>动态</h1>
    </div>
  </section>
  <section class="page-block">
    <div class="narrow">
      <DynamicFeed limit={24} />
    </div>
  </section>
</BaseLayout>
